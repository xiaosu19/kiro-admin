# Local development only. Use exact HTTPS origins and secure cookies in production.
DATABASE_URL=sqlite:///./console.db
SECRET_KEY=replace-with-at-least-32-random-characters
FERNET_KEY=replace-with-a-generated-fernet-key
SECURE_COOKIE=false
APP_ORIGIN=http://localhost:8000
VERIFY_ORIGIN=http://127.0.0.1:8000
AUTH_ALLOW_LOCAL_ORIGINS=true
PLAN_CHANGES_ENABLED=false

# Each user configures their own AI endpoint, key and model in JSON export.
# Global provider keys are never used as a fallback by background jobs.
CAPTCHA_MAX_ATTEMPTS=6
CAPTCHA_TOTAL_TIMEOUT_SECONDS=60
CAPTCHA_BROWSER_CONCURRENCY=2
WORKER_CONCURRENCY=4
AUTH_WORKER_CONCURRENCY=2
PER_ACCOUNT_CONCURRENCY=2
# Optional: use an installed Chromium instead of Playwright's managed browser.
# CAPTCHA_CHROMIUM_EXECUTABLE=/usr/bin/chromium
