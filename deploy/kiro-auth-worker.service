[Unit]
Description=Kiro Console native authentication worker
After=network-online.target kiro-console.service
Wants=network-online.target

[Service]
User=kiro-console
Group=kiro-console
WorkingDirectory=/opt/kiro-console/current/backend
EnvironmentFile=/etc/kiro-console/app.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/kiro-console/browsers
ExecStart=/opt/kiro-console/venv/bin/python -m app.auth_worker
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kiro-console
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
