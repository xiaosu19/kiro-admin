server {
    listen 80 default_server;
    server_name __DOMAIN__ __PUBLIC_IP__;
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://__DOMAIN__$request_uri; }
}
server {
    listen 443 ssl;
    server_name __DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/kiro-console-domain/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kiro-console-domain/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 64k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }
}
server {
    listen 443 ssl default_server;
    server_name __PUBLIC_IP__;
    ssl_certificate /etc/letsencrypt/live/kiro-console/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kiro-console/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://__DOMAIN__$request_uri;
}
